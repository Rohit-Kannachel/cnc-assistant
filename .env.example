# Copy this file to .env and fill in your values. .env is git-ignored.

# Anthropic API key (needed from Phase 3 onward).
ANTHROPIC_API_KEY=

# Claude model used by the operation planner.
CLAUDE_MODEL=claude-sonnet-5-5

# Flask secret key (used for flash messages). Any long random string.
SECRET_KEY=change-me

# Where the database, uploads and generated gcode live.
# Relative paths are resolved from the directory you start the app in.
CNC_DATA_DIR=instance

# Web server bind address. Use 0.0.0.0 to reach it from other machines on your network.
CNC_HOST=127.0.0.1
CNC_PORT=5000
